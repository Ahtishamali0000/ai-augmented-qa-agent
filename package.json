{
  "name": "qa-ai-framework-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/jira-server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:login": "playwright test --grep \"@login\"",
    "test:e2e:smoke": "playwright test --grep \"@smoke\"",
    "test:e2e:report": "playwright show-report reports/playwright/html",
    "test:homepage": "playwright test --grep @homepage --project=chromium",
    "test:login": "playwright test --grep @login --project=chromium",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:auth": "playwright test --grep @auth --project=chromium",
    "test:stable": "playwright test --grep \"@smoke|@login|@homepage\" --project=chromium",
    "test:regression": "playwright test --grep @regression --project=chromium",
    "test:report": "playwright show-report reports/playwright/html",
    "bddgen": "bddgen --config playwright.bdd.config.ts",
    "test:bdd": "npm run bddgen && playwright test --config=playwright.bdd.config.ts",
    "test:bdd:chromium": "npm run bddgen && playwright test --config=playwright.bdd.config.ts --project=chromium",
    "test:bdd:firefox": "npm run bddgen && playwright test --config=playwright.bdd.config.ts --project=firefox",
    "test:bdd:webkit": "npm run bddgen && playwright test --config=playwright.bdd.config.ts --project=webkit",
    "test:bdd:all": "npm run bddgen && playwright test --config=playwright.bdd.config.ts --project=chromium --project=firefox --project=webkit",
    "test:bdd:smoke": "npm run bddgen && playwright test --config=playwright.bdd.config.ts --grep @smoke --project=chromium",
    "test:bdd:auth": "npm run bddgen && playwright test --config=playwright.bdd.config.ts --grep @auth",
    "test:bdd:regression": "npm run bddgen && playwright test --config=playwright.bdd.config.ts --grep @regression",
    "test:bdd:failed": "npm run bddgen && playwright test --config=playwright.bdd.config.ts --last-failed",
    "test:failed": "playwright test --last-failed",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:open": "playwright show-report reports/playwright/html",
    "report:excel": "tsx scripts/generate-excel-report.ts",
    "report:markdown": "tsx scripts/generate-markdown-reports.ts",
    "migrate:pending-bdd": "tsx scripts/migrate-pending-specs-to-bdd.ts",
    "analyze:ticket": "tsx src/cli/analyze-ticket.ts",
    "approve:ticket": "tsx src/cli/analyze-ticket.ts --approve",
    "jira:tickets": "tsx src/cli/analyze-ticket.ts --list",
    "ci:jira-ticket": "tsx src/cli/github-action-ticket.ts",
    "mcp:server": "tsx src/mcp/qa-mcp-server.ts",
    "generate:test-cases": "tsx src/cli/analyze-ticket.ts",
    "generate:script": "tsx src/cli/analyze-ticket.ts",
    "approve:script": "tsx src/cli/analyze-ticket.ts --approve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@playwright/test": "^1.53.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "playwright-bdd": "^9.2.0",
    "tsx": "^4.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
